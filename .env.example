# Local development (docker compose). Copy to .env. None of these values are secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://tamva:tamva@postgres:5432/tamva
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_BEHIND_PROXY=false
POSTGRES_DB=tamva
POSTGRES_USER=tamva
POSTGRES_PASSWORD=tamva

# Recovery emails are printed to the worker/web console in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RECOVERY_LINK_BASE=tamva://reset-password

# Exports: local disk by default. To exercise the production path, run
# `docker compose --profile storage up` (MinIO) and set:
# EXPORT_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=tamva-private
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=tamva-dev
# AWS_SECRET_ACCESS_KEY=tamva-dev-secret
# AWS_S3_ADDRESSING_STYLE=path
EXPORT_STORAGE_BACKEND=filesystem

# --- Logging / observability -------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
APP_ENVIRONMENT=development
# APP_VERSION defaults to the VERSION file; APP_RELEASE is the build id (git SHA), set by the build.
APP_RELEASE=

# --- Throttling (per client IP or user) ----------------------------------------
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_CREDENTIAL_OPS=20/min
THROTTLE_RATE_CONNECTOR_SYNC=30/min
THROTTLE_RATE_RISK_EVALUATION=60/min
THROTTLE_RATE_PASSPORT_ACCESS=30/min
THROTTLE_RATE_SECURITY_OBSERVATION=120/min
THROTTLE_RATE_EXPORT=10/min
THROTTLE_RATE_BULK=20/min
THROTTLE_RATE_REGISTRATION=10/hour
THROTTLE_RATE_RECOVERY=10/hour

# --- Exports / background work --------------------------------------------------
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_ROWS=50000
EXPORT_LINK_TTL_SECONDS=300
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
