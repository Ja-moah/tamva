DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=replace-with-a-unique-staging-secret-at-least-50-characters-long
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.staging.example.com
DATABASE_URL=postgresql://tamva:replace-me@postgres:5432/tamva
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CORS_ALLOWED_ORIGINS=https://admin.staging.example.com,https://customer.staging.example.com
CSRF_TRUSTED_ORIGINS=https://admin.staging.example.com,https://customer.staging.example.com
LOG_LEVEL=INFO
SENTRY_DSN=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_BEHIND_PROXY=true
POSTGRES_DB=tamva
POSTGRES_USER=tamva
POSTGRES_PASSWORD=replace-me
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_CREDENTIAL_OPS=20/min
THROTTLE_RATE_CONNECTOR_SYNC=30/min
THROTTLE_RATE_RISK_EVALUATION=60/min
THROTTLE_RATE_PASSPORT_ACCESS=30/min
THROTTLE_RATE_SECURITY_OBSERVATION=120/min
