# TAMVA production environment. Copy to .env.production (git-ignored) and replace every CHANGE_ME.
# Nothing here is a real secret or a real domain; the app refuses to start on placeholders.
# Full reference: docs/operations/ENVIRONMENT_VARIABLES.md

# --- Domains -------------------------------------------------------------------
# One variable drives the edge proxy (Caddy) hostnames: www / app / admin / api / docs.<domain>.
# Production hosts are <sub>.<domain> directly.
TAMVA_DOMAIN=example.com
# Contact address Let's Encrypt uses for certificate expiry notices.
TAMVA_ACME_EMAIL=CHANGE_ME
# Written out to match TAMVA_DOMAIN (env files are not interpolated):
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://admin.example.com

# --- Sizing (optional) ---
# WEB_CONCURRENCY=2
# CELERY_CONCURRENCY=2
# TAMVA_IMAGE_TAG=local

# --- Django ----------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_BEHIND_PROXY=true
DJANGO_NUM_PROXIES=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# Preload is effectively irreversible. Leave false until the domain is settled.
DJANGO_HSTS_PRELOAD=false
API_DOCS_ENABLED=false
DJANGO_ADMIN_ENABLED=false

# --- PostgreSQL ---------------------------------------------------------------------
POSTGRES_DB=tamva
POSTGRES_USER=tamva
POSTGRES_PASSWORD=CHANGE_ME
# Use sslmode=require (or verify-full) when the database is not on the private compose network.
DATABASE_URL=postgresql://tamva:CHANGE_ME@postgres:5432/tamva
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis / Celery -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Private object storage (S3-compatible; the bucket must NOT be public) ---------------
EXPORT_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=CHANGE_ME
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ADDRESSING_STYLE=auto
AWS_QUERYSTRING_EXPIRE=60
AWS_S3_SSE=

# --- Email (account recovery) ----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CHANGE_ME
# The reset link customers open (an https universal link or the Mobile web origin).
RECOVERY_LINK_BASE=https://app.example.com/reset-password
RECOVERY_TOKEN_LIFETIME_MINUTES=60

# --- Logging / observability -------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
APP_ENVIRONMENT=production
# APP_VERSION defaults to the VERSION file; APP_RELEASE is the build id (git SHA), set by the build.
APP_RELEASE=

# --- Throttling (per client IP or user) ----------------------------------------
THROTTLE_RATE_AUTH=20/min
THROTTLE_RATE_CREDENTIAL_OPS=20/min
THROTTLE_RATE_CONNECTOR_SYNC=30/min
THROTTLE_RATE_RISK_EVALUATION=60/min
THROTTLE_RATE_PASSPORT_ACCESS=30/min
THROTTLE_RATE_SECURITY_OBSERVATION=120/min
THROTTLE_RATE_EXPORT=10/min
THROTTLE_RATE_BULK=20/min
THROTTLE_RATE_REGISTRATION=10/hour
THROTTLE_RATE_RECOVERY=10/hour

# --- Exports / background work --------------------------------------------------
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_ROWS=50000
EXPORT_LINK_TTL_SECONDS=300
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360
