{
  "name": "tamva-clients",
  "private": true,
  "workspaces": [
    "contracts/client",
    "frontend/admin",
    "frontend/customer",
    "mobile"
  ],
  "scripts": {
    "build": "npm run build --workspace @tamva/admin --workspace @tamva/customer",
    "dev:admin": "npm run dev --workspace @tamva/admin",
    "dev:customer": "npm run dev --workspace @tamva/customer",
    "dev:mobile": "npm run start --workspace @tamva/mobile",
    "test": "npm run test --workspace @tamva/admin --workspace @tamva/customer",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
