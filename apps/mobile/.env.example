# Copy to .env for local development. Everything here is PUBLIC (bundled into the app).
#
# EXPO_PUBLIC_APP_ENV: development (default) | staging | production
#   Staging and production builds refuse to start unless EXPO_PUBLIC_API_BASE_URL is a bare
#   https origin on a real host, and refuse demo mode. In EAS builds set the API URL as an
#   EAS environment variable (eas env:create), never in this file.
EXPO_PUBLIC_APP_ENV=development
# iOS simulator / local web: http://localhost:8000
# Android emulator:          http://10.0.2.2:8000
# Physical device:           the development machine's LAN address
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Sample-data design review without a backend. Development only.
# EXPO_PUBLIC_DEMO_MODE=true
